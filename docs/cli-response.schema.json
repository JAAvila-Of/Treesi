{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Treesi CLI response envelope version 1",
  "type": "object",
  "required": ["schemaVersion", "requestId", "contentTrust", "ok", "data", "error", "metrics"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "contentTrust": { "const": "untrusted" },
    "ok": { "type": "boolean" },
    "data": { "type": ["object", "null"] },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string" } }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["durationMs"],
      "properties": { "durationMs": { "type": "number", "minimum": 0 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" }, "data": { "type": "object" } } },
      "else": { "properties": { "error": { "type": "object" }, "data": { "type": "null" } } }
    }
  ]
}
