<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" Condition="'$(MSBuildProjectName)' == 'Treesi.Packaging'" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" Condition="'$(MSBuildProjectName)' == 'Treesi.Packaging'" />
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.6" />
    <PackageVersion Include="JAAvila.FluentOperations" Version="1.5.2" />
    <PackageVersion Include="JAAvila.FluentOperations.Analyzers" Version="1.5.0" />
    <PackageVersion Include="JAAvila.FluentOperations.Architecture" Version="1.5.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" Condition="'$(MSBuildProjectName)' == 'Treesi.NativeProfiler'" />
  </ItemGroup>
</Project>
