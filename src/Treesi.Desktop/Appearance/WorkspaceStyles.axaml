<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Surface.Window">#F0F1F4</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Panel">#F6F6F8</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Sidebar">#F0F1F4</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Control">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Hover">#E9EAEE</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Selected">#E6E9F0</SolidColorBrush>
          <SolidColorBrush x:Key="Border.Default">#D6D8DF</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Primary">#24262D</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Secondary">#5D626F</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Subtle">#6C707B</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Primary">#25704E</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Hover">#1E6042</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Contrast">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Soft">#E9EBF0</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.Canvas">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.Gutter">#F6F6F8</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddBackground">#E5F4E9</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddText">#216039</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveBackground">#FCE9EB</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveText">#A02E40</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.HunkBackground">#EDF2FC</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.HunkText">#375B91</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddInline">#BFE3CB</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveInline">#F1BEC9</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Keyword">#52318C</SolidColorBrush>
          <SolidColorBrush x:Key="Code.String">#70451A</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Number">#135368</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Comment">#3D5864</SolidColorBrush>
          <SolidColorBrush x:Key="Status.Warning">#8A550B</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Surface.Window">#17181C</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Panel">#202126</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Sidebar">#1C1D22</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Control">#202126</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Hover">#2A2C33</SolidColorBrush>
          <SolidColorBrush x:Key="Surface.Selected">#2D3039</SolidColorBrush>
          <SolidColorBrush x:Key="Border.Default">#34363E</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Primary">#E8E9ED</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Secondary">#AAACB6</SolidColorBrush>
          <SolidColorBrush x:Key="Text.Subtle">#858995</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Primary">#8DD6B5</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Hover">#A6E3C7</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Contrast">#10251F</SolidColorBrush>
          <SolidColorBrush x:Key="Accent.Soft">#2A2C33</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.Canvas">#17181C</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.Gutter">#1C1D22</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddBackground">#173729</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddText">#A5E7B9</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveBackground">#3B222B</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveText">#FFADB9</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.HunkBackground">#1B2B42</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.HunkText">#B3CBF8</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.AddInline">#28533E</SolidColorBrush>
          <SolidColorBrush x:Key="Diff.RemoveInline">#653342</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Keyword">#CBB9FF</SolidColorBrush>
          <SolidColorBrush x:Key="Code.String">#E9CD98</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Number">#A6DFF2</SolidColorBrush>
          <SolidColorBrush x:Key="Code.Comment">#BECBD4</SolidColorBrush>
          <SolidColorBrush x:Key="Status.Warning">#ECC180</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window.workspace">
    <Setter Property="Background" Value="{DynamicResource Surface.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontFamily" Value="Segoe UI, SF Pro Text, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /></Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{DynamicResource Text.Subtle}" />
    <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.1" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,5" /><Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Window.workspace.motion-enabled Button">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.workspace.motion-enabled Button:pointerover"><Setter Property="RenderTransform" Value="translate(0px, -1px)" /></Style>
  <Style Selector="Window.workspace.motion-enabled Button:pressed"><Setter Property="RenderTransform" Value="scale(0.98)" /></Style>
  <Style Selector="Window.workspace.motion-enabled Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.workspace.motion-enabled ListBoxItem /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Contrast}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Contrast}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.active-mode"><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style Selector="ListBox.graph-rows ListBoxItem">
    <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="36" /><Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Subtle}" />
  </Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="TextBox:focus-visible, ComboBox:focus-visible, ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="Border#DiffSurface"><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /></Style>
  <Style Selector="Border#DiffSurface:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    <Setter Property="CornerRadius" Value="6" /><Setter Property="FontSize" Value="12" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    <Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="11,11" /><Setter Property="Margin" Value="10,3" />
    <Setter Property="CornerRadius" Value="9" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="MinHeight" Value="60" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
  </Style>
  <Style Selector="TextBlock.file-status"><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="TabStrip.repository-tabs TabStripItem">
    <Setter Property="Theme">
      <ControlTheme TargetType="TabStripItem">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,2,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </Setter>
  </Style>
  <Style Selector="TabStrip.repository-tabs TabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource Surface.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
  </Style>
  <Style Selector="TabStrip.repository-tabs TabStripItem:pointerover:not(:selected)"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Style>
  <Style Selector="TabStrip.repository-tabs TabStripItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="Button.workspace-picker">
    <Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="14,0" />
    <Setter Property="BorderThickness" Value="0,0,1,0" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
  </Style>
  <Style Selector="ListBox.changed-files ListBoxItem, Grid.history-navigation ListBoxItem">
    <Setter Property="Margin" Value="0" /><Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="TabStrip.diff-modes TabStripItem">
    <Setter Property="Theme">
      <ControlTheme TargetType="TabStripItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </Setter>
  </Style>
  <Style Selector="TabStrip.diff-modes TabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
  </Style>
  <Style Selector="TabStrip.diff-modes TabStripItem:pointerover:not(:selected)"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Style>
  <Style Selector="TabStrip.diff-modes TabStripItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Style>
  <Style Selector="Window.workspace.motion-enabled TabStrip.diff-modes TabStripItem">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /></Transitions></Setter>
  </Style>
  <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{DynamicResource Diff.AddText}" /></Style>
  <Style Selector="TextBlock.removed"><Setter Property="Foreground" Value="{DynamicResource Diff.RemoveText}" /></Style>
  <Style Selector="editing|TextArea">
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="SelectionForeground" Value="{DynamicResource Text.Primary}" />
  </Style>
</Styles>
