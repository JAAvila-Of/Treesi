<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:local="clr-namespace:Treesi.Desktop"
        xmlns:workspaces="clr-namespace:Treesi.Desktop.Workspaces"
        xmlns:domain="clr-namespace:Treesi.Domain;assembly=Treesi.Domain"
        xmlns:graph="clr-namespace:Treesi.Desktop.Graph"
        x:Class="Treesi.Desktop.MainWindow" Classes="workspace"
        Title="Treesi — Change inspection" Width="1180" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,26">
    <Grid x:Name="RepositoryTabBar" ColumnDefinitions="190,*,Auto,Auto" Background="{DynamicResource Surface.Sidebar}" Height="36">
      <Button x:Name="WorkspacePickerButton" AutomationProperties.AutomationId="WorkspacePickerButton" Classes="quiet workspace-picker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Choose a local workspace; groups organize shortcuts without opening repositories">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Path Data="M9,6 L9,22 M9,15 C9,10 21,15 21,8 M6,6 A3,3 0 1 0 12,6 A3,3 0 1 0 6,6 M18,5 A3,3 0 1 0 24,5 A3,3 0 1 0 18,5" Width="17" Height="20" Stretch="Uniform" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="1.6" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="WorkspacePickerCaption" AutomationProperties.AutomationId="WorkspacePickerCaption" Text="Local repositories" MaxWidth="128" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
          <Path Grid.Column="2" Data="M1,1 L5,5 L9,1" Width="8" Height="4" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.4" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Height="36">
        <TabStrip x:Name="RepositoryTabs" Classes="repository-tabs" AutomationProperties.AutomationId="RepositoryTabs" AutomationProperties.Name="Open repository tabs" Background="Transparent">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="workspaces:RepositoryTab">
              <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Root}">
                <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                <Button Content="×" Tag="{Binding}" Click="CloseRepositoryTab" Classes="quiet" MinHeight="24" Padding="4,0" FontSize="14" AutomationProperties.Name="{Binding CloseLabel}" ToolTip.Tip="Close tab; repository files are not changed" />
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
      </ScrollViewer>
      <Button Grid.Column="2" x:Name="NewRepositoryTabButton" AutomationProperties.AutomationId="NewRepositoryTabButton" Content="+" Classes="quiet" MinHeight="30" Padding="12,0" FontSize="18" AutomationProperties.Name="Open another repository tab" ToolTip.Tip="Choose a local repository (Ctrl+T)" />
      <ComboBox Grid.Column="3" x:Name="ThemeSelector" AutomationProperties.AutomationId="ThemeSelector" Width="86" Margin="4,3,10,3" AutomationProperties.Name="Appearance theme" ToolTip.Tip="Appearance theme" />
    </Grid>
    <Grid x:Name="WorkspaceHeader" Grid.Row="1" ColumnDefinitions="190,*,Auto" Height="40" Background="{DynamicResource Surface.Window}">
      <StackPanel Spacing="1" Margin="14,0,10,0" VerticalAlignment="Center" ToolTip.Tip="Inspect the active local repository">
        <TextBlock x:Name="RepositoryName" AutomationProperties.AutomationId="RepositoryName" Text="No repository open" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="RepositoryLocation" Text="Choose a local Git working tree" Classes="secondary" FontSize="9" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="10,0" VerticalAlignment="Center">
        <Button x:Name="GraphViewButton" AutomationProperties.AutomationId="GraphViewButton" Content="Graph" Classes="quiet" IsEnabled="False" />
        <Button x:Name="ChangesViewButton" AutomationProperties.AutomationId="ChangesViewButton" Classes="quiet active-mode"><TextBlock x:Name="WorkspaceContext" Text="Changes" FontSize="12" /></Button>
        <Button x:Name="HistoryButton" AutomationProperties.AutomationId="HistoryButton" Content="History" Classes="quiet" Padding="9,4" IsEnabled="False" ToolTip.Tip="Browse local repository or file history" />
        <Button x:Name="CompareRevisionsButton" AutomationProperties.AutomationId="CompareRevisionsButton" Content="Compare" Classes="quiet" IsEnabled="False" ToolTip.Tip="Compare existing local commits, branches or tags" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
        <Button x:Name="RecentWorkspacesButton" AutomationProperties.AutomationId="RecentWorkspacesButton" Content="Recents" Classes="quiet" ToolTip.Tip="Open the recent repository chooser" />
        <Button x:Name="OpenFileButton" AutomationProperties.AutomationId="OpenFileButton" Content="Open file" Classes="quiet" ToolTip.Tip="Open a file inside a repository" />
        <Button x:Name="OpenFolderButton" AutomationProperties.AutomationId="OpenFolderButton" Content="Open repository" Classes="quiet" ToolTip.Tip="Open a local repository (Ctrl+O)" />
      </StackPanel>
    </Grid>
    <ProgressBar x:Name="BusyIndicator" Grid.Row="1" IsVisible="False" IsIndeterminate="False" Value="100" Height="2" VerticalAlignment="Bottom" Margin="12,0" Foreground="{DynamicResource Accent.Primary}" Background="Transparent" AutomationProperties.Name="Inspection in progress" />
    <Border x:Name="WorkspaceFrame" Grid.Row="2" Margin="0" CornerRadius="0" ClipToBounds="True" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}">
      <Grid x:Name="WorkspaceColumns" ColumnDefinitions="190,1,*">
        <Grid x:Name="FilesPanel" Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Surface.Sidebar}">
          <Grid x:Name="ChangesNavigationHeader" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,10,8,7">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="ChangesHeading" Text="Changed files" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
              <Border Background="{DynamicResource Surface.Hover}" CornerRadius="4" Padding="6,2">
                <TextBlock x:Name="FileCount" Text="0" FontSize="11" Classes="secondary" />
              </Border>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="↻" Classes="quiet" Padding="8,4" MinHeight="28" FontSize="18" IsEnabled="False" ToolTip.Tip="Refresh changes (Ctrl+R)" AutomationProperties.Name="Refresh changes" />
          </Grid>
          <TextBox Grid.Row="1" x:Name="FileFilter" AutomationProperties.AutomationId="FileFilter" PlaceholderText="Filter files…" Margin="12,0,12,12" AutomationProperties.Name="Filter changed files by path" />
          <ListBox Grid.Row="2" x:Name="ChangedFiles" Classes="changed-files" AutomationProperties.AutomationId="ChangedFiles" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Changed files">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ChangedFileItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding State}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Primary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Text="{Binding Directory}" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="file-status" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" FontFamily="monospace" FontSize="10" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid x:Name="HistorySidebar" Grid.Row="0" Grid.RowSpan="3" Classes="history-navigation" IsVisible="False" Background="{DynamicResource Surface.Sidebar}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="6,0,6,6" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="History" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" />
              <Button Grid.Column="1" x:Name="HistoryFilesButton" AutomationProperties.AutomationId="HistoryFilesButton" Content="Files" Classes="quiet" Padding="8,4" ToolTip.Tip="Show files in the current comparison" />
            </Grid>
            <ComboBox Grid.Row="1" x:Name="HistoryScopeSelector" AutomationProperties.AutomationId="HistoryScopeSelector" AutomationProperties.Name="History scope" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="Repository" /><ComboBoxItem Content="Selected file" />
            </ComboBox>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBox x:Name="HistoryStartInput" AutomationProperties.AutomationId="HistoryStartInput" Text="HEAD" MaxLength="512" AutomationProperties.Name="History start revision" />
              <Button Grid.Column="1" x:Name="ReloadHistoryButton" AutomationProperties.AutomationId="ReloadHistoryButton" Content="Go" Classes="quiet" Padding="8,4" ToolTip.Tip="Start fresh history from this local revision" />
            </Grid>
            <TextBlock Grid.Row="3" x:Name="HistoryNotice" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HistoryNotice" Classes="secondary" FontSize="10" TextWrapping="Wrap" Margin="6,0" />
            <ListBox Grid.Row="4" x:Name="HistoryCommits" AutomationProperties.AutomationId="HistoryCommits" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Local commits">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryCommitItem">
                  <StackPanel Spacing="4" ToolTip.Tip="{Binding Subject}">
                    <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium" />
                    <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" Classes="secondary" FontSize="10" />
                    <TextBlock Text="{Binding AuthoredAt}" TextTrimming="CharacterEllipsis" Classes="secondary" FontSize="9" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="4">
              <Button x:Name="PreviousHistoryButton" AutomationProperties.AutomationId="PreviousHistoryButton" Content="Previous" Classes="quiet" Padding="6,4" IsEnabled="False" />
              <Button Grid.Column="1" x:Name="NextHistoryButton" AutomationProperties.AutomationId="NextHistoryButton" Content="Next" Classes="quiet" Padding="6,4" IsEnabled="False" />
            </Grid>
          </Grid>
          <Border Grid.Row="3" Padding="14,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}">
            <TextBlock x:Name="WorkspaceScopeHint" Text="Local changes · read only" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
        <Border x:Name="FilesSeparator" Grid.Column="1" Background="{DynamicResource Border.Default}" />
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Background="{DynamicResource Surface.Panel}">
          <Grid x:Name="FileHeading" Margin="12,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Height="34">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="FileTitle" AutomationProperties.AutomationId="FileTitle" Text="Change inspection" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ComparisonDescription" AutomationProperties.AutomationId="ComparisonDescription" Text="Select a repository to start reviewing." Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Border CornerRadius="0" Padding="2,3" Background="Transparent"><TextBlock x:Name="AddedCount" AutomationProperties.AutomationId="AddedCount" Text="+0" Classes="added" FontFamily="monospace" FontSize="11" /></Border>
              <Border CornerRadius="0" Padding="2,3" Background="Transparent"><TextBlock x:Name="RemovedCount" AutomationProperties.AutomationId="RemovedCount" Text="−0" Classes="removed" FontFamily="monospace" FontSize="11" /></Border>
              <Border x:Name="WhitespaceNotice" IsVisible="False" CornerRadius="5" Padding="6,3" BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1">
                <TextBlock x:Name="WhitespaceWarningText" AutomationProperties.AutomationId="WhitespaceWarningText" Text="WS ignored" Foreground="{DynamicResource Status.Warning}" FontSize="10" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBox x:Name="DiffSearch" AutomationProperties.AutomationId="DiffSearch" PlaceholderText="Find in diff…" Width="140" AutomationProperties.Name="Find text in diff" AutomationProperties.HelpText="Enter or F3 finds the next match; Shift+Enter or Shift+F3 finds the previous match." />
              <Button x:Name="FindNextButton" AutomationProperties.AutomationId="FindNextButton" Content="Find" Classes="quiet" ToolTip.Tip="Find the next occurrence" />
              <Button x:Name="DiffOptionsButton" AutomationProperties.AutomationId="DiffOptionsButton" Content="Options" Classes="quiet" IsEnabled="False" AutomationProperties.Name="Comparison options" />
            </StackPanel>
          </Grid>
          <Border x:Name="ComparisonToolbar" Grid.Row="1" Background="{DynamicResource Surface.Window}" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Border.Default}" Padding="6,3">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
              <Button x:Name="ToggleFilesButton" AutomationProperties.AutomationId="ToggleFilesButton" Content="☰" Classes="quiet" Width="30" AutomationProperties.Name="Hide file panel" ToolTip.Tip="Show or hide files (Ctrl+B)" />
              <Grid Grid.Column="1" Width="192">
              <ComboBox x:Name="ComparisonSelector" AutomationProperties.AutomationId="ComparisonSelector" Width="192" SelectedIndex="0" AutomationProperties.Name="Comparison endpoints">
                <ComboBoxItem Content="Working tree vs Index" />
                <ComboBoxItem Content="Index vs HEAD" />
                <ComboBoxItem Content="Working tree vs HEAD" />
              </ComboBox>
              <Button x:Name="RevisionEndpointsButton" AutomationProperties.AutomationId="RevisionEndpointsButton" IsVisible="False" Content="Compared commits" FontFamily="monospace" FontSize="10" HorizontalAlignment="Stretch" />
              </Grid>
              <Border Grid.Column="2" Background="{DynamicResource Surface.Control}" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}" Padding="2">
                <TabStrip x:Name="DiffModeSelector" Classes="diff-modes" AutomationProperties.AutomationId="DiffModeSelector" SelectedIndex="0" AutomationProperties.Name="Diff layout">
                  <TabStripItem x:Name="UnifiedModeButton" AutomationProperties.AutomationId="UnifiedModeButton" Content="Unified" />
                  <TabStripItem x:Name="SplitModeButton" AutomationProperties.AutomationId="SplitModeButton" Content="Side by side" />
                </TabStrip>
              </Border>
              <Border Grid.Column="3" x:Name="DiffLabel" IsVisible="False" IsHitTestVisible="False">
                <TextBlock x:Name="DiffLayoutLabel" Text="UNIFIED" IsVisible="False" />
              </Border>
              <TextBlock Grid.Column="4" x:Name="BlockPosition" Text="No change blocks" Classes="secondary" FontSize="10" VerticalAlignment="Center" />
              <Button Grid.Column="5" x:Name="PreviousBlockButton" AutomationProperties.AutomationId="PreviousBlockButton" Content="↑" Classes="quiet" Width="28" ToolTip.Tip="Previous change block (Alt+Up)" AutomationProperties.Name="Previous change block" />
              <Button Grid.Column="6" x:Name="NextBlockButton" AutomationProperties.AutomationId="NextBlockButton" Content="↓" Classes="quiet" Width="28" ToolTip.Tip="Next change block (Alt+Down)" AutomationProperties.Name="Next change block" />
            </Grid>
          </Border>
          <Border x:Name="DiffSurface" Grid.Row="2" Margin="0" Background="{DynamicResource Diff.Canvas}" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
          <Grid Background="{DynamicResource Diff.Canvas}">
            <Grid x:Name="EmptyState" Margin="36">
              <StackPanel MaxWidth="380" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Accent.Soft}" HorizontalAlignment="Center" Margin="0,0,0,6">
                  <Path Data="M4,8 L12,8 M8,4 L8,12 M17,19 L25,19 M14,4 L14,24" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" AutomationProperties.AutomationId="EmptyTitle" Text="See what changed." FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="Open a repository or a single file. Get a clear view of the changes, right where you need it." Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                <TextBlock Text="Ctrl+O to open a repository" Classes="secondary" FontSize="11" TextAlignment="Center" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
            <local:ReadOnlyDiffEditor x:Name="DiffEditor" IsVisible="False" IsReadOnly="True" ShowLineNumbers="False"
                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13"
                               Background="{DynamicResource Diff.Canvas}" Foreground="{DynamicResource Text.Primary}"
                               Padding="0,8,0,16" WordWrap="False" AutomationProperties.Name="Read-only unified diff" />
            <Grid x:Name="SplitView" IsVisible="False" ColumnDefinitions="*,1,*" RowDefinitions="26,*">
              <Border Background="{DynamicResource Diff.Gutter}" Padding="12,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Default}">
                <TextBlock x:Name="BeforeLabel" Text="BEFORE" Classes="eyebrow" FontSize="10" />
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource Diff.Gutter}" Padding="12,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Default}">
                <TextBlock x:Name="AfterLabel" Text="AFTER" Classes="eyebrow" FontSize="10" />
              </Border>
              <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Border.Default}" />
              <local:ReadOnlyDiffEditor x:Name="BeforeEditor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="False" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" Background="{DynamicResource Diff.Canvas}" Foreground="{DynamicResource Text.Primary}" Padding="0,8,0,16" WordWrap="False" AutomationProperties.Name="Read-only before diff" />
              <local:ReadOnlyDiffEditor x:Name="AfterEditor" Grid.Row="1" Grid.Column="2" IsReadOnly="True" ShowLineNumbers="False" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" Background="{DynamicResource Diff.Canvas}" Foreground="{DynamicResource Text.Primary}" Padding="0,8,0,16" WordWrap="False" AutomationProperties.Name="Read-only after diff" />
            </Grid>
          </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="GraphFrame" Grid.Row="2" IsVisible="False" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Window}">
      <Grid x:Name="GraphColumns" ColumnDefinitions="180,1,*">
        <Grid x:Name="GraphSidebar" RowDefinitions="Auto,Auto,*" Background="{DynamicResource Surface.Sidebar}">
          <TextBlock Text="References" FontSize="11" Classes="secondary" Margin="14,12,10,10" />
          <TextBox Grid.Row="1" x:Name="GraphReferenceFilter" AutomationProperties.AutomationId="GraphReferenceFilter" PlaceholderText="Filter references…" Margin="12,0,12,10" AutomationProperties.Name="Filter graph references" />
          <ListBox Grid.Row="2" x:Name="GraphReferences" Classes="changed-files" AutomationProperties.AutomationId="GraphReferences" AutomationProperties.Name="Graph reference scope" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate><DataTemplate x:DataType="graph:GraphReferenceChoice"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Kind}" Classes="secondary" FontSize="10" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Column="1" x:Name="GraphSeparator" Background="{DynamicResource Border.Default}" />
        <Grid Grid.Column="2" RowDefinitions="34,22,*,28">
          <Grid Margin="8,1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
            <TextBox x:Name="GraphStartInput" AutomationProperties.AutomationId="GraphStartInput" Width="150" PlaceholderText="All local references" MaxLength="512" AutomationProperties.Name="Graph start reference; blank includes local reference tips" />
            <Button Grid.Column="1" x:Name="GraphGoButton" AutomationProperties.AutomationId="GraphGoButton" Content="Go" Classes="quiet" Padding="7,3" />
            <Button Grid.Column="2" x:Name="GraphRefreshButton" AutomationProperties.AutomationId="GraphRefreshButton" Content="Refresh" Classes="quiet" Padding="7,3" ToolTip.Tip="Resolve current graph reference tips again" />
            <TextBox Grid.Column="4" x:Name="GraphFindInput" AutomationProperties.AutomationId="GraphFindInput" Width="120" PlaceholderText="Find a commit…" AutomationProperties.Name="Find in loaded graph; Enter selects next match" />
            <Button Grid.Column="5" x:Name="GraphDetailsButton" AutomationProperties.AutomationId="GraphDetailsButton" Content="Details" Classes="quiet" Padding="7,3" />
            <Button Grid.Column="6" x:Name="GraphReviewButton" AutomationProperties.AutomationId="GraphReviewButton" Content="Review" Classes="quiet" Padding="7,3" IsEnabled="False" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="116,144,*,96,64" Background="{DynamicResource Surface.Sidebar}">
            <TextBlock Text="References" Classes="secondary" FontSize="10" Margin="8,3" /><TextBlock Grid.Column="1" Text="Graph" Classes="secondary" FontSize="10" Margin="8,3" /><TextBlock Grid.Column="2" Text="Commit" Classes="secondary" FontSize="10" Margin="8,3" /><TextBlock Grid.Column="3" Text="Author" Classes="secondary" FontSize="10" Margin="4,3" /><TextBlock Grid.Column="4" Text="Date" Classes="secondary" FontSize="10" Margin="4,3" />
          </Grid>
          <ListBox Grid.Row="2" x:Name="GraphCommits" Classes="graph-rows" AutomationProperties.AutomationId="GraphCommits" AutomationProperties.Name="Commit graph; child commits precede parents" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="graph:GraphRow">
                <Grid ColumnDefinitions="114,144,*,96,64" Height="36" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding ReferenceLabel}" Foreground="{DynamicResource Accent.Primary}" FontSize="10" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding References}" />
                  <graph:GraphLaneCanvas Grid.Column="1" Row="{Binding}" Height="36" IsHitTestVisible="False" />
                  <TextBlock Grid.Column="2" Text="{Binding Subject}" FontSize="12" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subject}" />
                  <TextBlock Grid.Column="3" Text="{Binding Author}" Classes="secondary" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                  <TextBlock Grid.Column="4" Text="{Binding Date}" Classes="secondary" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" x:Name="EmptyGraph" Text="No graph loaded. Choose Go or Refresh to read local commits." Classes="secondary" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10,0">
            <TextBlock x:Name="GraphNotice" AutomationProperties.AutomationId="GraphNotice" AutomationProperties.LiveSetting="Polite" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="MoreGraphButton" AutomationProperties.AutomationId="MoreGraphButton" Content="Load more" Classes="quiet" MinHeight="26" Padding="7,2" FontSize="11" IsEnabled="False" />
          </Grid>
          <Border Grid.Row="1" Grid.RowSpan="3" x:Name="GraphInspector" IsVisible="False" ZIndex="5" Width="272" HorizontalAlignment="Right" Padding="16" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1,0,0,0" BoxShadow="-8 0 24 0 #20000000">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Selected commit" Classes="secondary" FontSize="11" /><Button Grid.Column="1" x:Name="CloseGraphDetailsButton" Content="×" Classes="quiet" MinHeight="24" Padding="5,0" AutomationProperties.Name="Close graph details" /></Grid>
              <ScrollViewer Grid.Row="1"><StackPanel Spacing="16"><TextBlock x:Name="GraphCommitTitle" AutomationProperties.AutomationId="GraphCommitTitle" FontSize="17" TextWrapping="Wrap" /><TextBlock x:Name="GraphCommitIdentity" FontFamily="monospace" FontSize="10" TextWrapping="Wrap" /><TextBlock x:Name="GraphCommitAuthor" Classes="secondary" FontSize="12" TextWrapping="Wrap" /><TextBlock x:Name="GraphCommitParents" Classes="secondary" FontSize="10" TextWrapping="Wrap" /><TextBlock Text="Review opens the parent-to-commit comparison in the full code canvas." Classes="secondary" FontSize="11" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
              <Button Grid.Row="2" x:Name="ReviewGraphCommitButton" AutomationProperties.AutomationId="ReviewGraphCommitButton" Content="Review changes →" Classes="primary" HorizontalAlignment="Stretch" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="HomeSurface" Grid.Row="2" Margin="6,0,6,2" IsVisible="False" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Panel}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="28,18" MaxWidth="820">
        <StackPanel Spacing="8" Margin="0,0,0,14">
          <TextBlock Text="LOCAL WORKSPACES" Classes="eyebrow" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Pick up where you left off." FontSize="25" FontWeight="SemiBold" />
            <Button Grid.Column="1" x:Name="ReturnToWorkspaceButton" AutomationProperties.AutomationId="ReturnToWorkspaceButton" Content="Back to comparison" Classes="quiet" IsVisible="False" />
          </Grid>
          <TextBlock Text="Open a repository or a single file. Recent locations are inspected only when you choose one." Classes="secondary" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
            <Button x:Name="HomeOpenRepositoryButton" AutomationProperties.AutomationId="HomeOpenRepositoryButton" Content="Open repository" Classes="primary" />
            <Button x:Name="HomeOpenFileButton" AutomationProperties.AutomationId="HomeOpenFileButton" Content="Open a file" />
          </StackPanel>
          <TextBlock x:Name="HomeNotice" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HomeNotice" IsVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource Status.Warning}" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Text="Recent repositories" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="ClearRecentsButton" AutomationProperties.AutomationId="ClearRecentsButton" Content="Clear list" Classes="quiet" />
          </Grid>
        </StackPanel>
        <Grid Grid.Row="1">
          <ListBox x:Name="RecentRepositories" AutomationProperties.AutomationId="RecentRepositories" AutomationProperties.Name="Recent repositories" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="workspaces:WorkspaceEntry">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                  <TextBlock Text="↗" Foreground="{DynamicResource Accent.Primary}" FontSize="20" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Root}" Classes="secondary" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root}" />
                    <TextBlock Text="{Binding View}" Classes="secondary" FontSize="10" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="NoRecentWorkspaces" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Your next review starts here." FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Open a local repository to add a shortcut." Classes="secondary" TextAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
          <TextBlock Text="Shortcuts only. Removing an entry never deletes a repository." Classes="secondary" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="RetryOpenButton" AutomationProperties.AutomationId="RetryOpenButton" Content="Retry location" IsVisible="False" />
          <Button Grid.Column="2" x:Name="RemoveRecentButton" AutomationProperties.AutomationId="RemoveRecentButton" Content="Remove shortcut" Classes="quiet" />
          <Button Grid.Column="3" x:Name="ResumeWorkspaceButton" AutomationProperties.AutomationId="ResumeWorkspaceButton" Content="Resume selected" Classes="primary" />
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="WorktreesPanel" Grid.Row="2" IsVisible="False" ZIndex="35" Width="650" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="16" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" BoxShadow="0 12 32 0 #30000000" AutomationProperties.Name="Related local worktrees">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="Related worktrees" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" x:Name="RefreshWorktreesButton" AutomationProperties.AutomationId="RefreshWorktreesButton" Content="Refresh" Classes="quiet" /><Button Grid.Column="2" x:Name="CloseWorktreesButton" AutomationProperties.AutomationId="CloseWorktreesButton" Content="×" Width="30" Classes="quiet" AutomationProperties.Name="Close related worktrees" /></Grid>
        <TextBlock Grid.Row="1" Text="Shared repository, independent working folders. Open a location to review its changes." Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        <ListBox Grid.Row="2" x:Name="RelatedWorktrees" AutomationProperties.AutomationId="RelatedWorktrees" AutomationProperties.Name="Registered worktree locations" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate><DataTemplate x:DataType="workspaces:WorktreeChoice"><Grid ColumnDefinitions="*,180" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Location}" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" /><TextBlock Text="{Binding State}" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Branch}" Foreground="{DynamicResource Accent.Primary}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" x:Name="WorktreeDetails" Classes="secondary" FontSize="10" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock x:Name="WorktreeNotice" AutomationProperties.AutomationId="WorktreeNotice" AutomationProperties.LiveSetting="Polite" Classes="secondary" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" x:Name="OpenWorktreeButton" AutomationProperties.AutomationId="OpenWorktreeButton" Content="Open selected" Classes="primary" IsEnabled="False" /></Grid>
      </Grid>
    </Border>
    <Border x:Name="WorkspacePickerPanel" Grid.Row="2" IsVisible="False" ZIndex="30" Width="650" Height="416" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="16" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" BoxShadow="0 12 32 0 #30000000" AutomationProperties.Name="Local workspace picker">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Workspaces" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="DiscoverWorktreesButton" AutomationProperties.AutomationId="DiscoverWorktreesButton" Content="Related worktrees" Classes="quiet" ToolTip.Tip="Read registered worktrees of the active repository" IsEnabled="False" />
          <Button Grid.Column="2" x:Name="NewWorkspaceGroupButton" AutomationProperties.AutomationId="NewWorkspaceGroupButton" Content="+ New workspace" Classes="quiet" />
          <Button Grid.Column="3" x:Name="CloseWorkspacePickerButton" AutomationProperties.AutomationId="CloseWorkspacePickerButton" Content="×" Classes="quiet" Width="30" AutomationProperties.Name="Close workspace picker" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="WorkspaceNameInput" AutomationProperties.AutomationId="WorkspaceNameInput" MaxLength="64" PlaceholderText="Workspace name" AutomationProperties.Name="Workspace name" />
          <Button Grid.Column="1" x:Name="SaveWorkspaceNameButton" AutomationProperties.AutomationId="SaveWorkspaceNameButton" Content="Save name" />
          <Button Grid.Column="2" x:Name="CancelWorkspaceNameButton" AutomationProperties.AutomationId="CancelWorkspaceNameButton" Content="Cancel" Classes="quiet" IsVisible="False" />
          <Button Grid.Column="3" x:Name="DeleteWorkspaceGroupButton" AutomationProperties.AutomationId="DeleteWorkspaceGroupButton" Content="Remove group" Classes="quiet" ToolTip.Tip="Remove this group of shortcuts; repository files and tabs are not changed" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="164,1,*" ColumnSpacing="10">
          <ListBox x:Name="WorkspaceGroupsList" Classes="changed-files" AutomationProperties.AutomationId="WorkspaceGroupsList" AutomationProperties.Name="Local workspaces" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="workspaces:WorkspaceGroupChoice">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                  <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="secondary" FontSize="10" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Column="1" Background="{DynamicResource Border.Default}" />
          <Grid Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="6">
            <ListBox x:Name="WorkspaceRepositoriesList" Classes="changed-files" AutomationProperties.AutomationId="WorkspaceRepositoriesList" AutomationProperties.Name="Workspace repository shortcuts" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="workspaces:WorkspaceRepositoryChoice">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Root}" Classes="secondary" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root}" />
                    <TextBlock Text="{Binding State}" Classes="secondary" FontSize="10" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyWorkspaceGroup" Text="No repositories here yet. Add the current repository or choose a local folder." Classes="secondary" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
              <Button x:Name="AddCurrentWorkspaceRepositoryButton" AutomationProperties.AutomationId="AddCurrentWorkspaceRepositoryButton" Content="Add current" Classes="quiet" Padding="7,4" ToolTip.Tip="Add the validated active repository without reading Git again" />
              <Button x:Name="AddWorkspaceRepositoryButton" AutomationProperties.AutomationId="AddWorkspaceRepositoryButton" Content="Add folder…" Classes="quiet" Padding="7,4" />
              <Button x:Name="ReplaceWorkspaceRepositoryButton" AutomationProperties.AutomationId="ReplaceWorkspaceRepositoryButton" Content="Replace location…" Classes="quiet" Padding="7,4" ToolTip.Tip="Choose and validate a replacement shortcut; no files are moved" />
            </StackPanel>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="3">
          <TextBlock x:Name="WorkspaceGroupNotice" AutomationProperties.AutomationId="WorkspaceGroupNotice" AutomationProperties.LiveSetting="Polite" Classes="secondary" FontSize="11" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="WorkspaceSessionNotice" Text="Session only · workspace settings are not being saved" IsVisible="False" Foreground="{DynamicResource Status.Warning}" FontSize="10" />
        </StackPanel>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button x:Name="RemoveWorkspaceRepositoryButton" AutomationProperties.AutomationId="RemoveWorkspaceRepositoryButton" Content="Remove shortcut" Classes="quiet" />
          <ProgressBar Grid.Column="1" x:Name="WorkspaceValidationIndicator" IsVisible="False" IsIndeterminate="False" Value="100" Width="36" Height="2" VerticalAlignment="Center" AutomationProperties.Name="Validating repository location" />
          <Button Grid.Column="3" x:Name="CancelWorkspaceValidationButton" AutomationProperties.AutomationId="CancelWorkspaceValidationButton" IsVisible="False" Content="Cancel validation" Classes="quiet" />
          <Button Grid.Column="4" x:Name="OpenWorkspaceRepositoryButton" AutomationProperties.AutomationId="OpenWorkspaceRepositoryButton" Content="Open selected" Classes="primary" />
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="OpenRecoveryNotice" Grid.Row="2" IsVisible="False" ZIndex="10" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="16" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1" BoxShadow="0 8 24 0 #30000000">
      <StackPanel Spacing="10">
        <TextBlock Text="The location could not be opened." FontWeight="SemiBold" />
        <TextBlock x:Name="OpenRecoveryMessage" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OpenRecoveryMessage" TextWrapping="Wrap" Classes="secondary" />
        <TextBlock Text="Your current comparison is still available." Classes="secondary" FontSize="11" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="RetryWorkspaceButton" AutomationProperties.AutomationId="RetryWorkspaceButton" Content="Retry" />
          <Button x:Name="ChooseWorkspaceButton" AutomationProperties.AutomationId="ChooseWorkspaceButton" Content="Choose another" />
          <Button x:Name="DismissRecoveryButton" AutomationProperties.AutomationId="DismissRecoveryButton" Content="Dismiss" Classes="quiet" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border x:Name="DiffOptionsPanel" Grid.Row="2" IsVisible="False" ZIndex="20" Width="368" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="18" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" BoxShadow="0 8 24 0 #30000000" AutomationProperties.Name="Comparison options">
      <StackPanel Spacing="12">
        <TextBlock Text="Comparison options" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Apply to the current comparison. Repository files remain unchanged." Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        <StackPanel Spacing="5">
          <Label Target="{Binding #ContextLinesInput}" Content="Context lines" Padding="0" />
          <CheckBox x:Name="FullContextToggle" AutomationProperties.AutomationId="FullContextToggle" Content="Full file context" MinHeight="24" FontSize="11" ToolTip.Tip="Include all surrounding lines of changed files, within preview limits. Does not load unchanged files." />
          <TextBox x:Name="ContextLinesInput" AutomationProperties.AutomationId="ContextLinesInput" AutomationProperties.Name="Context lines from 0 to 50" Text="3" MaxLength="3" />
          <TextBlock Text="0–50 lines around each change. Output limits still apply." Classes="secondary" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="5">
          <Label Target="{Binding #WhitespaceSelector}" Content="Whitespace" Padding="0" />
          <ComboBox x:Name="WhitespaceSelector" AutomationProperties.AutomationId="WhitespaceSelector" AutomationProperties.Name="Whitespace policy" HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock Text="Ignoring whitespace can hide meaningful changes, including spaces inside strings. Use Exact to verify all changes." Foreground="{DynamicResource Status.Warning}" FontSize="11" TextWrapping="Wrap" />
        <TextBlock x:Name="DiffOptionsError" AutomationProperties.AutomationId="DiffOptionsError" AutomationProperties.LiveSetting="Polite" IsVisible="False" Foreground="{DynamicResource Status.Warning}" FontSize="11" TextWrapping="Wrap" />
        <StackPanel Spacing="2">
          <CheckBox x:Name="CodeColorsToggle" AutomationProperties.AutomationId="CodeColorsToggle" Content="Code colors (C#, JSON)" IsChecked="True" MinHeight="26" FontSize="11" ToolTip.Tip="Lexical colors for visible fragments. Context outside a change block is unknown." />
          <CheckBox x:Name="InlineChangesToggle" AutomationProperties.AutomationId="InlineChangesToggle" Content="Emphasize changed text" IsChecked="True" MinHeight="26" FontSize="11" ToolTip.Tip="Bounded comparison of paired removed and added lines; display only." />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button x:Name="ResetDiffOptionsButton" AutomationProperties.AutomationId="ResetDiffOptionsButton" Content="Defaults" Classes="quiet" />
          <Button Grid.Column="2" x:Name="CancelDiffOptionsButton" AutomationProperties.AutomationId="CancelDiffOptionsButton" Content="Cancel" Classes="quiet" />
          <Button Grid.Column="3" x:Name="ApplyDiffOptionsButton" AutomationProperties.AutomationId="ApplyDiffOptionsButton" Content="Apply" Classes="primary" />
        </Grid>
      </StackPanel>
    </Border>
    <Border x:Name="RevisionPanel" Grid.Row="2" IsVisible="False" ZIndex="25" Width="460" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="16" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" BoxShadow="0 8 24 0 #30000000" AutomationProperties.Name="Compare local revisions">
      <Grid x:Name="RevisionPanelLayout" RowDefinitions="Auto,*,Auto" Height="320" RowSpacing="12">
        <TextBlock Text="Compare local revisions" FontSize="18" FontWeight="SemiBold" />
        <StackPanel x:Name="RevisionDraft" Grid.Row="1" Spacing="8">
          <Label Target="{Binding #BaseRevisionInput}" Content="Base revision" Padding="0" />
          <TextBox x:Name="BaseRevisionInput" AutomationProperties.AutomationId="BaseRevisionInput" AutomationProperties.Name="Base revision" Text="HEAD~1" MaxLength="512" />
          <Label Target="{Binding #TargetRevisionInput}" Content="Target revision" Padding="0" />
          <TextBox x:Name="TargetRevisionInput" AutomationProperties.AutomationId="TargetRevisionInput" AutomationProperties.Name="Target revision" Text="HEAD" MaxLength="512" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <ComboBox x:Name="RevisionModeSelector" AutomationProperties.AutomationId="RevisionModeSelector" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Revision comparison mode">
              <ComboBoxItem Content="Direct: base to target" /><ComboBoxItem Content="Merge base to target" />
            </ComboBox>
            <Button Grid.Column="1" x:Name="SwapRevisionsButton" AutomationProperties.AutomationId="SwapRevisionsButton" Content="Swap" Classes="quiet" />
            <Button Grid.Column="2" x:Name="BrowseRevisionReferencesButton" AutomationProperties.AutomationId="BrowseRevisionReferencesButton" Content="Browse refs" />
          </Grid>
          <TextBlock Text="Use commit IDs, local refs, or ~n/^n ancestry (up to 999 per step). Comparison pins commits until you explicitly refresh. No fetch is performed." Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="RevisionError" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RevisionError" IsVisible="False" Foreground="{DynamicResource Status.Warning}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Grid x:Name="RevisionReferencePicker" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock x:Name="RevisionReferenceNotice" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RevisionReferenceNotice" Text="Choose a local reference." Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          <ListBox x:Name="RevisionReferencesList" Grid.Row="1" AutomationProperties.AutomationId="RevisionReferencesList" AutomationProperties.Name="Local references" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="domain:RevisionReference">
                <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /><TextBlock Text="{Binding Kind}" Classes="secondary" FontSize="10" /></StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Grid x:Name="RevisionDraftActions" Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button x:Name="ReturnToWorkingButton" AutomationProperties.AutomationId="ReturnToWorkingButton" Content="Working changes" Classes="quiet" IsVisible="False" />
          <Button Grid.Column="2" x:Name="CancelRevisionButton" AutomationProperties.AutomationId="CancelRevisionButton" Content="Cancel" Classes="quiet" />
          <Button Grid.Column="3" x:Name="ApplyRevisionButton" AutomationProperties.AutomationId="ApplyRevisionButton" Content="Compare" Classes="primary" />
        </Grid>
        <Grid x:Name="RevisionReferenceActions" Grid.Row="2" IsVisible="False" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button x:Name="BackToRevisionDraftButton" AutomationProperties.AutomationId="BackToRevisionDraftButton" Content="Back" Classes="quiet" />
          <Button Grid.Column="2" x:Name="UseReferenceAsBaseButton" AutomationProperties.AutomationId="UseReferenceAsBaseButton" Content="Use as base" />
          <Button Grid.Column="3" x:Name="UseReferenceAsTargetButton" AutomationProperties.AutomationId="UseReferenceAsTargetButton" Content="Use as target" Classes="primary" />
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="CommitDetailsPanel" Grid.Row="2" IsVisible="False" ZIndex="26" Width="430" MaxHeight="410" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="16" CornerRadius="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" BoxShadow="0 8 24 0 #30000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <TextBlock Text="Commit details" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" x:Name="CommitIdentity" AutomationProperties.AutomationId="CommitIdentity" FontFamily="monospace" FontSize="10" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" x:Name="CommitAuthor" Classes="secondary" FontSize="10" TextWrapping="Wrap" MaxHeight="70" />
        <TextBox Grid.Row="3" x:Name="CommitMessage" AutomationProperties.AutomationId="CommitMessage" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="140" AutomationProperties.Name="Untrusted commit message" />
        <ComboBox Grid.Row="4" x:Name="CommitParentSelector" AutomationProperties.AutomationId="CommitParentSelector" AutomationProperties.Name="Compare against parent" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <Button x:Name="CommitWorkingButton" AutomationProperties.AutomationId="CommitWorkingButton" Content="Working changes" Classes="quiet" Padding="8,5" />
          <Button Grid.Column="1" x:Name="CloseCommitDetailsButton" AutomationProperties.AutomationId="CloseCommitDetailsButton" Content="Close" Classes="quiet" Padding="8,5" />
          <Button Grid.Column="2" x:Name="ApplyCommitParentButton" AutomationProperties.AutomationId="ApplyCommitParentButton" Content="Compare" Classes="primary" Padding="8,5" />
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,0">
      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <Path Data="M3,10 L3,6 A5,5 0 0 1 13,6 L13,10 M1,10 L15,10 L15,21 L1,21 Z" Width="10" Height="12" Stretch="Uniform" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.5" />
        <TextBlock Text="Read-only" Classes="secondary" FontSize="10" />
        <Button x:Name="BackToGraphButton" AutomationProperties.AutomationId="BackToGraphButton" Content="← Graph" Classes="quiet" IsVisible="False" FontSize="10" MinHeight="24" Padding="5,0" ToolTip.Tip="Return to the saved graph selection without reading Git" />
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="OperationStatus" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OperationStatus" Text="Open a repository to begin" Classes="secondary" FontSize="10" Margin="18,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <CheckBox Grid.Column="2" x:Name="ReduceMotionToggle" AutomationProperties.AutomationId="ReduceMotionToggle" Content="Reduce motion" FontSize="10" MinHeight="24" ToolTip.Tip="Reduce decorative motion" VerticalAlignment="Center" />
      <Button Grid.Column="3" x:Name="FocusWorkspaceButton" AutomationProperties.AutomationId="FocusWorkspaceButton" Content="Focus" Classes="quiet" MinHeight="24" Padding="8,2" FontSize="10" AutomationProperties.Name="Enter focus mode" ToolTip.Tip="Focus comparison (Ctrl+Shift+F); Escape restores the workspace" />
      <Button Grid.Column="4" x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="Cancel inspection" Classes="quiet" IsVisible="False" MinHeight="26" Padding="6,2" FontSize="10" />
    </Grid>
  </Grid>
</Window>
